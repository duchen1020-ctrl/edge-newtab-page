{
  "manifest_version": 3,
  "name": "我的美化主页 - 新标签页",
  "version": "1.0",
  "description": "让浏览器每个新标签页都显示美化主页：搜索框 + 可自定义壁纸（上传/链接/文件夹）+ 动态壁纸轮换。",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["clipboardWrite"],
  "host_permissions": [
    "https://music.163.com/*",
    "https://*.music.126.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
